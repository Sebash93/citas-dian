# Local settings for citas-dian. Copy to .env (git-ignored) and fill in:
#   cp .env.example .env
# Load it into your shell before running anything:
#   set -a; source .env; set +a
#   PYTHONPATH=src python3 -m dian_monitor --cases
# Never commit .env: it holds tokens. All variables are optional; see src/dian_monitor/config.py.

# --- Cases (Airtable) -----------------------------------------------------------------------
# Personal Access Token (airtable.com/create/tokens) with only data.records:read and
# data.records:write, and access to one base only.
AIRTABLE_TOKEN=
# Test base "Citas DIAN – Pruebas" (fake people). Production is appXwq5qS7lS5crch.
AIRTABLE_BASE_ID=app8tLx90fSe4u0nj
# Table name or tbl… id.
AIRTABLE_TABLE=Cases
# Bogotá hours after which the monitor reads the cases again (it also reads them at start).
DIAN_CASES_REFRESH_HOURS=6,11,14

# --- Alerts (Telegram) ----------------------------------------------------------------------
# Empty = alerts are only printed. List chat ids with: python -m dian_monitor --telegram-chats
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Booker ---------------------------------------------------------------------------------
# 1 = start a booker on openings (the human still solves every captcha).
DIAN_BOOKER=0
# 1 = stop before Agendar (keep it on while testing).
BOOKER_DRY_RUN=1
# Only this tramite is ever booked.
DIAN_SERVICE=vehiculos
# "owner/repo" to start bookers on GitHub Actions instead of locally (needs the token below).
DIAN_BOOKER_REPO=
GITHUB_DISPATCH_TOKEN=

# --- Local files ----------------------------------------------------------------------------
DIAN_STATE_FILE=state/state.json
DIAN_EVENTS_FILE=state/events.jsonl
DIAN_CASES_CACHE_FILE=state/cases-cache.json
DIAN_CAPTURES_DIR=captures

# --- Monitoring (optional) ------------------------------------------------------------------
# healthchecks.io ping URL; it contains a secret key.
DIAN_HEALTHCHECK_URL=
